# Copy to .env for local development. Never commit a real .env file.
#
# This matches `vault server -dev` defaults: KV v2 auto-mounted at "secret",
# root token fixed to the value below via VAULT_DEV_ROOT_TOKEN_ID.

VAULTLY_VAULT_ADDR=http://127.0.0.1:8200
VAULTLY_VAULT_AUTH_METHOD=token
VAULTLY_VAULT_TOKEN=vaultly-dev-root-token
VAULTLY_VAULT_KV_MOUNT=secret

# Bearer token clients must send to Vaultly's own API. Generate a real
# random value for anything beyond local dev, e.g.: openssl rand -hex 32
VAULTLY_API_BEARER_TOKEN=local-dev-token

VAULTLY_DB_SECRET_PATH=vaultly/database
VAULTLY_ROTATION_POLL_INTERVAL_SECONDS=30
VAULTLY_LOG_LEVEL=INFO
